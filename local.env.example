# Copy to local.env. Never use a VITE_ prefix for a secret.
API_KEY=
# Optional: Named local service or loopback HTTP endpoint.
RRH_DECISIONS_URL=http://rrh-llm-1:4000/v1/decisions
# Optional: limits on questions sent to the decision service (answers from the
# shared cache are free). Set both for a public deployment; 0 or unset = none.
# DECISIONS_CLIENT_QPS=5          # per player (address), questions a second
# DECISIONS_DAILY_CAP=5000000     # whole service, questions per UTC day
# DECISIONS_CACHE_SIZE=50000      # answers kept for repeats; 0 turns it off
